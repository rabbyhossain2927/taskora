# Pass the sign-in token through to PHP on Apache/LiteSpeed hosting
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Keep secrets and helper files private
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|schema\.sql|\.user\.ini)$">
  Require all denied
</FilesMatch>
Options -Indexes
