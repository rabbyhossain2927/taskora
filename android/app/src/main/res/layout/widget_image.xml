<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="6dp">
    <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:contentDescription="TaskOra" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="Open TaskOra once to fill this widget" android:textColor="#7A7A8C"
        android:textSize="12sp" android:padding="12dp" />
</FrameLayout>
