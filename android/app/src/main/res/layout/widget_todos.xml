<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Today"
            android:textColor="#2A2A3A" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7A7A8C" android:textSize="12sp" />
        <TextView android:id="@+id/add" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="10dp"
            android:background="@drawable/widget_add" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_circle" android:contentDescription="Tick" />
        <TextView android:id="@+id/title0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="#2A2A3A" android:textSize="13.5sp" />
        <TextView android:id="@+id/when0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#7A7A8C" android:textSize="11.5sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_circle" android:contentDescription="Tick" />
        <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="#2A2A3A" android:textSize="13.5sp" />
        <TextView android:id="@+id/when1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#7A7A8C" android:textSize="11.5sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_circle" android:contentDescription="Tick" />
        <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="#2A2A3A" android:textSize="13.5sp" />
        <TextView android:id="@+id/when2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#7A7A8C" android:textSize="11.5sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_circle" android:contentDescription="Tick" />
        <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="#2A2A3A" android:textSize="13.5sp" />
        <TextView android:id="@+id/when3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#7A7A8C" android:textSize="11.5sp" />
    </LinearLayout>
    <TextView android:id="@+id/none" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="Nothing due today" android:textColor="#7A7A8C" android:textSize="13sp" android:visibility="gone" />
</LinearLayout>
